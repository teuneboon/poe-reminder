[Unit]
Description=PoE Reminder - hideout reminders for Path of Exile
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=dbus
BusName=local.PoeReminder
ExecStart=/usr/bin/python3 %h/.local/bin/poe-reminder
Restart=on-failure
RestartSec=3

[Install]
WantedBy=graphical-session.target
